#!/bin/sh
# 推送前闸门（fail-closed）
#
# 与 pre-commit 的分工：
#   pre-commit 看「这一次提交」，pre-push 看「即将公开的整段历史」。
#   密钥在第 3 次提交写入、第 9 次提交删除时，pre-commit 永远是绿的，
#   但克隆者 git log -p 仍能拿到 —— 只有全历史检查能发现。
#
# 两条规则：
#   1. 私有备份分支（local-backup*）绝不允许推送到公开远端（github.com）
#   2. 其余要推送的分支，必须通过 scripts/check_public_ready.py
#
# 启用方式（仓库根目录执行一次）：git config core.hooksPath .githooks
# 应急绕过：git push --no-verify（自行承担历史泄露风险）

PY=""
for cand in python python3 py; do
    if command -v "$cand" >/dev/null 2>&1; then
        PY="$cand"
        break
    fi
done

REMOTE_NAME="$1"
REMOTE_URL="$2"

if [ -z "$PY" ]; then
    echo "[pre-push] 找不到 python 解释器，无法执行公开闸门 —— 按 fail-closed 规则阻断推送。" >&2
    exit 1
fi

STATUS=0
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
    # 全 0 的 sha 表示删除远端分支，没有内容要检查
    case "$LOCAL_SHA" in
        0000000000000000000000000000000000000000) continue ;;
    esac

    BRANCH=$(printf '%s' "$LOCAL_REF" | sed 's|^refs/heads/||')

    case "$BRANCH" in
        local-backup*)
            case "$REMOTE_URL" in
                *github.com*)
                    echo "[pre-push] 拒绝：私有备份分支 $BRANCH 含数据与裁决记录，不得推送到公开远端。" >&2
                    echo "[pre-push] 公开只推 main：git push github main" >&2
                    STATUS=1
                    ;;
            esac
            continue
            ;;
    esac

    echo "[pre-push] 检查 $BRANCH（$(printf '%s' "$LOCAL_SHA" | cut -c1-7)）的完整历史 ..."
    if ! "$PY" scripts/check_public_ready.py --ref "$LOCAL_SHA" --no-demo --quiet; then
        STATUS=1
    fi
done

if [ "$STATUS" -ne 0 ]; then
    echo "" >&2
    echo "[pre-push] 推送被拦截。按上面提示处理后重试；" >&2
    echo "[pre-push] 若确认要绕过：git push --no-verify（历史一旦公开不可撤回）。" >&2
fi
exit "$STATUS"
